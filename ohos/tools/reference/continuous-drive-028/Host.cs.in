namespace Newtonsoft.Json {
 public enum MemberSerialization{OptIn}
 [AttributeUsage(AttributeTargets.Class)]public class JsonObjectAttribute:Attribute{public JsonObjectAttribute(MemberSerialization value){}}
 [AttributeUsage(AttributeTargets.Property)]public class JsonPropertyAttribute:Attribute{}
}
namespace PropertyChanged {[AttributeUsage(AttributeTargets.Property)]public class DoNotNotifyAttribute:Attribute{}}
namespace MultiFunPlayer.Property {public interface IPropertyManager {void RegisterProperty<TIn,TOut>(string name,Func<TIn,TOut> getter);}}
namespace MultiFunPlayer.Shortcut {
 internal interface IShortcutActionConfiguration{}
 internal interface IShortcutActionRunner {bool ScheduleInvoke(IEnumerable<IShortcutActionConfiguration> configurations,IInputGestureData data,Action callback);}
 class Configuration:IShortcutActionConfiguration{}
 class Runner:IShortcutActionRunner {
  public readonly List<IAxisInputGestureData> Values=[];public bool Accept=true;public bool CompleteImmediately=true;private Action _complete;
  public bool ScheduleInvoke(IEnumerable<IShortcutActionConfiguration> configurations,IInputGestureData data,Action callback){if(!Accept)return false;Values.Add((IAxisInputGestureData)data);_complete=callback;if(CompleteImmediately)Complete();return true;}
  public void Complete(){var completion=_complete;_complete=null;completion?.Invoke();}
 }
 internal abstract class AbstractShortcut<TGesture,TData>(IShortcutActionRunner actionRunner,IInputGestureDescriptor gesture)
  where TGesture:IInputGesture where TData:IInputGestureData {
  private bool _isScheduled;private Action _tick;
  public List<IShortcutActionConfiguration> Configurations{get;}=[new Configuration()];
  public bool Running=>_tick!=null;public TimeSpan Period{get;private set;}public int Starts{get;private set;}
  protected abstract void Update(TGesture input);public void Deliver(TGesture input)=>Update(input);
  @@INVOKE@@
  @@ON_INVOKED@@
  protected bool IsRepeatRunning()=>Running;
  protected void CancelRepeat()=>_tick=null;
  protected void Repeat(TimeSpan period,Action callback){Period=period;_tick=callback;Starts++;}
  public void Tick()=>_tick?.Invoke();
 }
 public class Builder<T> {
  public Builder<T> WithLabel(string value)=>this;public Builder<T> WithItemsSource(IEnumerable<T> value)=>this;public Builder<T> WithDefaultValue(T value)=>this;
  public Builder<T> AsNumericUpDown(double minimum=double.MinValue,double maximum=double.MaxValue,double interval=1,string stringFormat=null)=>this;
 }
 public interface IShortcutManager {
  void RegisterAction(string name,Action action);
  void RegisterAction<T1>(string name,Action<Builder<T1>> a,Action<T1> action);
  void RegisterAction<T1,T2>(string name,Action<Builder<T1>> a,Action<Builder<T2>> b,Action<T1,T2> action);
  void RegisterAction<T1,T2>(string name,Action<Builder<T2>> b,Action<T1,T2> action);
  void RegisterAction<T1,T2,T3>(string name,Action<Builder<T1>> a,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<T1,T2,T3> action);
  void RegisterAction<T1,T2,T3>(string name,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<T1,T2,T3> action);
  void RegisterAction<T1,T2,T3,T4>(string name,Action<Builder<T1>> a,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<Builder<T4>> d,Action<T1,T2,T3,T4> action);
  void RegisterAction<T1,T2,T3,T4>(string name,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<Builder<T4>> d,Action<T1,T2,T3,T4> action);
 }
 public class Capture:IShortcutManager {
  public Dictionary<string,Delegate> Actions{get;}=new();
  public void RegisterAction(string name,Action action)=>Actions[name]=action;
  public void RegisterAction<T1>(string name,Action<Builder<T1>> a,Action<T1> action)=>Actions[name]=action;
  public void RegisterAction<T1,T2>(string name,Action<Builder<T1>> a,Action<Builder<T2>> b,Action<T1,T2> action)=>Actions[name]=action;
  public void RegisterAction<T1,T2>(string name,Action<Builder<T2>> b,Action<T1,T2> action)=>Actions[name]=action;
  public void RegisterAction<T1,T2,T3>(string name,Action<Builder<T1>> a,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<T1,T2,T3> action)=>Actions[name]=action;
  public void RegisterAction<T1,T2,T3>(string name,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<T1,T2,T3> action)=>Actions[name]=action;
  public void RegisterAction<T1,T2,T3,T4>(string name,Action<Builder<T1>> a,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<Builder<T4>> d,Action<T1,T2,T3,T4> action)=>Actions[name]=action;
  public void RegisterAction<T1,T2,T3,T4>(string name,Action<Builder<T2>> b,Action<Builder<T3>> c,Action<Builder<T4>> d,Action<T1,T2,T3,T4> action)=>Actions[name]=action;
 }
}
